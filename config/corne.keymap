#include <behaviors.dtsi>
#include "keys_da.h"
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>

/ {
    combos {
        compatible = "zmk,combos";

        backspace {
            bindings = <&kp BACKSPACE>;
            key-positions = <7 8>;
            layers = <0 1 2 3>;
        };

        delete {
            bindings = <&kp DELETE>;
            key-positions = <8 9>;
            layers = <0 1 2 3>;
        };

        left_paranthesis {
            bindings = <&kp DA_LEFT_PARENTHESIS>;
            key-positions = <3 2>;
            layers = <0>;
        };

        right_paranthesis {
            bindings = <&kp DA_RIGHT_PARENTHESIS>;
            key-positions = <3 4>;
            layers = <0>;
        };

        left_bracket {
            bindings = <&kp DA_LEFT_BRACKET>;
            key-positions = <14 15>;
            layers = <0>;
        };

        right_bracket {
            bindings = <&kp DA_RIGHT_BRACKET>;
            key-positions = <15 16>;
            layers = <0>;
        };

        left_brace {
            bindings = <&kp DA_LEFT_BRACE>;
            key-positions = <26 27>;
            layers = <0>;
        };

        right_brace {
            bindings = <&kp DA_RIGHT_BRACE>;
            key-positions = <28 27>;
            layers = <0>;
        };

        quotation_combo {
            bindings = <&kp DA_DOUBLE_QUOTES>;
            key-positions = <4 5>;
            layers = <0>;
        };

        single-quote {
            bindings = <&kp DA_SINGLE_QUOTE>;
            key-positions = <29 28>;
            layers = <0>;
        };

        power-toggle {
            bindings = <&ext_power EP_TOG>;
            key-positions = <0 12 24>;
            layers = <0>;
        };

        power-on {
            bindings = <&ext_power EP_ON>;
            key-positions = <1 13 25>;
            layers = <0>;
        };

        hash {
            bindings = <&kp DA_HASH>;
            key-positions = <22 23>;
            layers = <0>;
        };

        dollar {
            bindings = <&kp DA_DOLLAR>;
            key-positions = <34 35>;
            layers = <0>;
        };

        at {
            bindings = <&kp DA_AT>;
            key-positions = <1 2>;
            layers = <0>;
        };

        minus-combo {
            bindings = <&kp DA_MINUS>;
            key-positions = <6 7>;
            layers = <0>;
        };

        underscore-combo {
            bindings = <&kp DA_UNDERSCORE>;
            key-positions = <30 31>;
            layers = <0>;
        };

        shift-left-combo {
            bindings = <&kp LEFT_SHIFT>;
            key-positions = <16 17>;
            layers = <0>;
        };

        shift-combo-right {
            bindings = <&kp RIGHT_SHIFT>;
            key-positions = <18 19>;
            layers = <0>;
        };

        semicolon_combo {
            bindings = <&kp DA_SEMICOLON>;
            key-positions = <19 20>;
        };

        colon_combo {
            bindings = <&kp DA_COLON>;
            key-positions = <21 20>;
        };

        copy_combo {
            bindings = <&kp RC(DA_C)>;
            key-positions = <12 13>;
        };

        paste_combo {
            bindings = <&kp RC(DA_V)>;
            key-positions = <24 25>;
        };

        exclamation_combo {
            bindings = <&kp DA_EXCL>;
            key-positions = <10 11>;
        };
    };

    macros {
        smiling: smiling {
            compatible = "zmk,behavior-macro";
            label = "SMILING";
            #binding-cells = <0>;
            bindings = <&kp DA_COLON &kp DA_RIGHT_PARENTHESIS>;
        };
        laughing: laughing {
            compatible = "zmk,behavior-macro";
            label = "LAUGHING";
            #binding-cells = <0>;
            bindings = <&kp DA_COLON &kp LS(DA_D)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // -----------------------------------------------------------------------------------------
            // |  ESC |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | [ |
            // |LSHIFT|  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | CTRL |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | BKSP  |
            //                    | GUI | SPC | LWR |   | RSE | ENT  | ALT |

            bindings = <
&kp ESCAPE     &kp Q  &kp W  &kp E         &kp R  &kp T          &kp Y                    &kp U  &kp I      &kp O                   &kp P                    &kp DA_A_RING
&mt LSHFT TAB  &kp A  &kp S  &kp D         &kp F  &kp G          &kp H                    &kp J  &kp K      &kp DA_L                &kp DA_AE                &mt RSHFT DA_O_SLASH
&kp LCTRL      &kp Z  &kp X  &kp C         &kp V  &kp B          &kp N                    &kp M  &kp COMMA  &mt DA_MINUS DA_PERIOD  &mt DA_QUESTION DA_EXCL  &kp RIGHT_CONTROL
                             &kp LEFT_GUI  &mo 2  &lt 1 SPACE    &mt RIGHT_CONTROL ENTER  &mo 3  &kp RALT
            >;
        };

        arrows {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BKSP |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&bt BT_CLR  &trans  &trans        &trans          &bt BT_PRV  &bt BT_NXT    &trans   &kp PG_UP  &kp UP    &kp PAGE_DOWN  &trans  &trans
&trans      &trans  &kp LEFT_ALT  &kp LEFT_SHIFT  &kp LCTRL   &trans        &trans   &kp LEFT   &kp DOWN  &kp RIGHT      &trans  &trans
&trans      &trans  &trans        &trans          &trans      &trans        &trans   &trans     &trans    &trans         &trans  &trans
                                  &trans          &trans      &trans        &kp RET  &trans     &kp RALT
            >;

            label = "arrows+bt";
        };

        numeric {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &kp DA_SLASH  &kp N7     &kp N8  &kp N9  &trans        &trans
&trans  &trans  &trans  &trans  &trans  &trans    &kp DA_MINUS  &kp N4     &kp N5  &kp N6  &kp DA_EQUAL  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &kp PLUS      &kp N1     &kp N2  &kp N3  &trans        &trans
                        &trans  &trans  &trans    &kp RCTRL     &kp DA_N0  &trans
            >;

            label = "num";
        };

        function {
            bindings = <
&trans  &trans    &trans     &trans  &trans  &trans    &kp DA_SLASH      &kp F7  &kp F8  &kp F9  &trans  &kp C_VOLUME_UP
&trans  &smiling  &laughing  &trans  &trans  &trans    &kp DA_BACKSLASH  &kp F4  &kp F5  &kp F6  &trans  &kp C_VOLUME_DOWN
&trans  &trans    &trans     &trans  &trans  &trans    &kp DA_DOLLAR     &kp F1  &kp F2  &kp F3  &trans  &trans
                             &trans  &trans  &trans    &trans            &trans  &trans
            >;

            label = "fun :)";
        };
    };
};
