#include <behaviors.dtsi>
#include "keys_da.h"
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/keys.h>

/ {
    combos {
        compatible = "zmk,combos";

        backspace {
            bindings = <&kp BACKSPACE>;
            key-positions = <7 8>;
            layers = <0>;
        };

        delete {
            bindings = <&kp DELETE>;
            key-positions = <8 9>;
            layers = <0>;
        };

        copy {
            bindings = <&kp K_COPY>;
            key-positions = <26 27>;
        };

        paste {
            bindings = <&kp K_PASTE>;
            key-positions = <28 27>;
        };

        left_paranthesis {
            bindings = <&kp DA_LEFT_PARENTHESIS>;
            key-positions = <19 20>;
            layers = <0>;
        };

        right_paranthesis {
            bindings = <&kp DA_RIGHT_PARENTHESIS>;
            key-positions = <20 21>;
            layers = <0>;
        };

        left_bracket {
            bindings = <&kp DA_LEFT_BRACKET>;
            key-positions = <19 20>;
        };

        right_bracket {
            bindings = <&kp DA_RIGHT_BRACKET>;
            key-positions = <20 21>;
        };

        left_brace {
            bindings = <&kp RS(RA(DA_N8))>;
            key-positions = <7 8>;
            layers = <3>;
        };

        right_brace {
            bindings = <&kp RS(RA(DA_N9))>;
            key-positions = <8 9>;
            layers = <3>;
        };

        quotation_combo {
            bindings = <&kp DA_DOUBLE_QUOTES>;
            key-positions = <2 3>;
        };

        single-quote {
            bindings = <&kp DA_SINGLE_QUOTE>;
            key-positions = <14 15>;
            layers = <0>;
        };
    };

    macros {
        smiling: smiling {
            compatible = "zmk,behavior-macro";
            label = "SMILING";
            #binding-cells = <0>;
            bindings = <&kp DA_COLON &kp DA_RIGHT_PARENTHESIS>;
        };
        laughing: laughing {
            compatible = "zmk,behavior-macro";
            label = "LAUGHING";
            #binding-cells = <0>;
            bindings = <&kp DA_COLON &kp LS(DA_D)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | [ |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | BKSP  |
            //                    | GUI | SPC | LWR |   | RSE | ENT  | ALT |

            bindings = <
   &kp ESCAPE  &kp Q  &kp W     &kp E        &kp R  &kp T    &kp Y      &kp U      &kp I     &kp O                    &kp P         &kp DA_A_RING
&mt LSHFT TAB  &kp A  &kp S     &kp D        &kp F  &kp G    &kp H      &kp J      &kp K  &kp DA_L                &kp DA_AE  &mt RSHFT DA_O_SLASH
    &kp LCTRL  &kp Z  &kp X     &kp C        &kp V  &kp B    &kp N      &kp M  &kp COMMA   &kp DOT  &mt DA_QUESTION DA_EXCL    &mt RCTRL DA_MINUS
                             &kp LGUI  &lt 2 SPACE  &mo 1    &mo 3  &kp ENTER   &kp RALT
            >;
        };

        arrows {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BKSP |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
   &kp TAB  &trans        &trans          &trans  &bt BT_PRV  &bt BT_NXT     &trans    &trans    &kp UP     &trans  &trans  &trans
&bt BT_CLR  &trans  &kp LEFT_ALT  &kp LEFT_SHIFT   &kp LCTRL      &trans     &trans  &kp LEFT  &kp DOWN  &kp RIGHT  &trans  &trans
    &trans  &trans        &trans          &trans      &trans      &trans     &trans    &trans    &trans     &trans  &trans  &trans
                                          &trans      &trans      &trans    &kp RET    &trans  &kp RALT
            >;

            label = "arrows+bt";
        };

        numeric {
            bindings = <
&trans       &trans           &trans  &trans  &trans  &trans    &trans     &kp N7  &kp N8  &kp N9  &trans  &trans
&trans  &kt LC(TAB)  &kt LC(LS(TAB))  &trans  &trans  &trans    &trans     &kp N4  &kp N5  &kp N6  &trans  &trans
&trans       &trans           &trans  &trans  &trans  &trans    &trans     &kp N1  &kp N2  &kp N3  &trans  &trans
                                      &trans  &trans  &trans    &trans  &kp DA_N0  &trans
            >;

            label = "num";
        };

        function {
            bindings = <
&trans    &trans     &trans  &trans  &trans  &trans         &kp DA_SLASH  &kp F7  &kp F8  &kp F9  &trans  &trans
&trans  &smiling  &laughing  &trans  &trans  &trans    &kp RS(RA(DA_N7))  &kp F4  &kp F5  &kp F6  &trans  &trans
&trans    &trans     &trans  &trans  &trans  &trans        &kp DA_DOLLAR  &kp F1  &kp F2  &kp F3  &trans  &trans
                             &trans  &trans  &trans               &trans  &trans  &trans
            >;

            label = "fun :)";
        };
    };
};
